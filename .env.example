# Copy to .env. Loaded by uvicorn --env-file .env; never commit .env.
# oMLX: use aliases from your server, or choose models in Settings.
DOCMIND_PROTOCOL=openai
DOCMIND_BASE_URL=http://127.0.0.1:11435/v1
DOCMIND_LLM_MODEL=
DOCMIND_EMBED_MODEL=
DOCMIND_API_KEY=

# Optional separate embeddings API (OpenAI compatible or Ollama native).
# A separate URL never inherits the chat API key.
DOCMIND_EMBED_BASE_URL=
DOCMIND_EMBED_PROTOCOL=
DOCMIND_EMBED_API_KEY=

# JSON overrides; null removes a request parameter. No credentials here.
DOCMIND_LLM_OPTIONS={}
# Optional private storage/auth paths:
# DOCMIND_CONFIG=config.yaml
# DOCMIND_CHROMA_PATH=data/chroma_db
# DOCMIND_PROJECTS_PATH=data/projects
